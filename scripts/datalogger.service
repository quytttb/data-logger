[Unit]
Description=IoT Data Logger — Modbus, SQLite, sFTP
Documentation=https://github.com/quytttb/data-logger
After=network.target
Wants=network.target

[Service]
Type=simple
User=pi
Group=dialout
WorkingDirectory=/opt/datalogger
ExecStart=/opt/datalogger/datalogger

Environment="DATALOGGER_DATA_DIR=/opt/datalogger/var/data"
Environment="DATALOGGER_CONFIG_DIR=/opt/datalogger/config"
Environment="DATALOGGER_LOG_DIR=/opt/datalogger/var/logs"

Environment="DISPLAY=:0"
Environment="XAUTHORITY=/home/pi/.Xauthority"

Restart=always
RestartSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=datalogger

[Install]
WantedBy=graphical.target
