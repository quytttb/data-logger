// Allow the Data Logger kiosk user ("pi") to restart the Modbus RTU sensor
// simulator service without interactive authentication.
//
// Background: Qt QSerialPort sets TIOCEXCL on open. If the app crashes or
// exits while holding /run/data-logger/ttyVIRT0, the kernel exclusive flag
// stays stuck as long as socat still holds its fd — every later open fails
// EBUSY ("Device or resource busy") until the pty pair is recreated. The app
// auto-heals this by restarting modbus-simulator after N consecutive EBUSY
// failures (see ModbusWorker::connectToPort). This rule grants just that
// single unit's restart/start/stop to that single user.
polkit.addRule(function(action, subject) {
    if (subject.user !== "pi")
        return;
    if (action.id === "org.freedesktop.systemd1.manage-units") {
        var unit = action.lookup("unit");
        var verb = action.lookup("verb");
        if (unit === "modbus-simulator.service" &&
            (verb === "restart" || verb === "try-restart" ||
             verb === "start" || verb === "stop" ||
             verb === "reload-or-restart")) {
            return polkit.Result.YES;
        }
    }
});
