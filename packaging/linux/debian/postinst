#!/bin/sh
# Auto-enable and (re)start the kiosk service after install/upgrade.
set -e

case "$1" in
    configure)
        # Hardware license backup directory (writable by kiosk user pi).
        if [ ! -d /var/lib/datalogger ]; then
            mkdir -p /var/lib/datalogger
        fi
        chown pi:pi /var/lib/datalogger 2>/dev/null || true
        chmod 755 /var/lib/datalogger 2>/dev/null || true

        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload >/dev/null 2>&1 || true
            systemctl enable datalogger.service >/dev/null 2>&1 || true
            systemctl restart datalogger.service >/dev/null 2>&1 || true
        fi
        ;;
esac

exit 0
