#!/bin/sh
# Auto-enable and (re)start the kiosk service after install/upgrade.
set -e

case "$1" in
    configure)
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload >/dev/null 2>&1 || true
            systemctl enable datalogger.service >/dev/null 2>&1 || true
            systemctl restart datalogger.service >/dev/null 2>&1 || true
        fi
        ;;
esac

exit 0
